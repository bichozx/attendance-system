# URL del backend vista desde el SERVIDOR de Next.js (no desde el navegador)
BACKEND_URL=http://localhost:3000/api/v1

# Las cookies de sesión son "Secure" en producción. Solo para probar por HTTP desde otra
# máquina de la red local (ej. http://192.168.1.10:3100) ponga false. Nunca en un servidor público.
# COOKIE_SECURE=false
