# Contraseña local para PostgreSQL en docker-compose.yml.
# Genere una contraseña propia antes de copiar este archivo a .env.
POSTGRES_PASSWORD=

# Puerto en el PC (por defecto 5433). Debe coincidir con el de DATABASE_URL en backend/.env.
# Windows suele reservar el 5432 (Hyper-V/WSL) y Docker no puede usarlo.
POSTGRES_PORT=5433
